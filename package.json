    "live:faucet": "node live/faucet.mjs",
    "live:deploy": "node live/deploy.mjs",
    "live:deploy-bridge": "node live/deploy-bridge.mjs"
  },
  "dependencies": {
    "@theqrl/hypc": "^0.0.2",
    "@theqrl/wallet.js": "^2.0.2",
    "@theqrl/web3": "^0.4.4",
    "viem": "^2.31.0"
  }
